# Copy this file to .env in this directory (next to package.json).
# Use the connection string from your Neon develop branch, not production.
DATABASE_URL="postgresql://USER:PASSWORD@TEST_HOST/DATABASE?sslmode=require"

# Local development authentication
NEXTAUTH_URL="http://localhost:3000"
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="REPLACE_WITH_A_RANDOM_SECRET"

# Optional Swebowl defaults. Club settings and request values take precedence
# over team IDs and season below. Uncomment only when needed.
# SWEBOWL_TEAM_IDS=""
# SWEBOWL_SEASON_ID=""
# SWEBOWL_API_KEY=""

# Optional: log database queries locally
# DEBUG_PRISMA="true"
